# Normalize detected text in the index and always check it out with LF.
* text=auto eol=lf

# Known source/configuration/archive text must not depend on auto detection.
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.csv text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.node-version text eol=lf

# Preserve packaged assets and source documents byte for byte.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.icns -text
*.pdf -text
*.docx -text
*.xlsx -text
*.pptx -text
*.zip -text
*.gz -text
*.woff -text
*.woff2 -text
