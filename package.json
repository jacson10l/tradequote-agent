{
  "name": "tradequote-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "22.22.0",
    "pnpm": "10.13.1"
  },
  "scripts": {
    "dev": "pnpm --filter @tradequote/desktop dev",
    "build": "node scripts/check-icons.mjs && pnpm --filter @tradequote/desktop build",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "check": "biome check . && node --test scripts/check-boundaries.test.mjs scripts/check-icons.test.mjs scripts/desktop-executable.test.mjs scripts/contract-review-probe.test.mjs && node scripts/check-boundaries.mjs && pnpm wiki:check",
    "test": "node scripts/test-unit.mjs",
    "test:e2e": "pnpm build && playwright test",
    "package:mac": "pnpm build && pnpm --filter @tradequote/desktop package:mac",
    "package:win": "pnpm build && pnpm --filter @tradequote/desktop package:win",
    "native:rebuild": "pnpm --filter @tradequote/desktop exec electron-builder install-app-deps",
    "wiki:generate": "node wiki-project/scripts/build-code-index.mjs .",
    "wiki:check": "node wiki-project/scripts/build-code-index.mjs . --check && node wiki-project/scripts/lint-wiki.mjs .",
    "wiki:sync": "node wiki-project/scripts/check-wiki-sync.mjs .",
    "wiki:test": "node --test wiki-project/scripts/wiki-tools.test.mjs wiki-project/scripts/wiki-sync.test.mjs",
    "postinstall": "node scripts/prepare-electron.mjs && pnpm native:rebuild",
    "icons:generate": "pnpm --filter @tradequote/desktop exec electron ../../scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
